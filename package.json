        "wp-env:setup": "tests/wp-env-setup.sh"
    },
    "devDependencies": {
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "@wordpress/env": "^11.16.0",
        "dotenv": "^17.2.1",
        "prettier": "npm:wp-prettier@^3.0.3",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "sass": "^1.91.0",
        "vite": "^8.3.2",
        "vite-plugin-live-reload": "^3.1.0",
        "vite-plugin-wordpress-alias": "^1.0.0",
        "vue": "^3.5.21"
